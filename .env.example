# Local paid recording only. Copy to .env; the real file is gitignored.
OPENROUTER_API_KEY=

# Both guards are mandatory, finite and strictly positive; accepted and rejected responses count.
LLM_MAX_COST_PER_MODEL_USD=5
LLM_MAX_TOTAL_COST_USD=5

# Optional local overrides. Official scripts set provider, model and VCR mode explicitly.
VCR_REJECTED_ROOT=/tmp/ipbox_llm_rejected
